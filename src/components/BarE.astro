---
/**
 * The "E" monogram drawn as a horizontal bar chart.
 * variant="mark"   → compact logo
 * variant="figure" → large hero figure with axis, gridlines and labels (bars animate in)
 */
export interface Props {
  variant?: 'mark' | 'figure';
  size?: number;
  class?: string;
}
const { variant = 'mark', size = 28, class: className = '' } = Astro.props;
---

{
  variant === 'mark' ? (
    <svg class={className} width={size} height={size} viewBox="0 0 26 26" aria-hidden="true">
      <rect x="2" y="2" width="4" height="22" style="fill: var(--ink, #e9e4d8)" />
      <rect x="6" y="2" width="18" height="5" style="fill: var(--gold-fill, #c9a96e)" />
      <rect x="6" y="10.5" width="12" height="5" style="fill: var(--blue-fill, #4a6cf7)" />
      <rect x="6" y="19" width="16" height="5" style="fill: var(--pink-fill, #f8bfd6)" />
    </svg>
  ) : (
    <figure class:list={['bare-fig', className]}>
      <svg viewBox="0 0 420 300" role="img" aria-label="A stylized letter E drawn as a horizontal bar chart">
        <g class="bare-grid">
          <line x1="74" y1="16" x2="74" y2="276" />
          <line x1="174" y1="16" x2="174" y2="276" />
          <line x1="274" y1="16" x2="274" y2="276" />
          <line x1="374" y1="16" x2="374" y2="276" />
        </g>
        <g class="bare-label">
          <text x="0" y="59">signal</text>
          <text x="0" y="152">research</text>
          <text x="0" y="245">product</text>
          <text x="70" y="294">0</text>
          <text x="168" y="294">25</text>
          <text x="268" y="294">50</text>
          <text x="368" y="294">75</text>
        </g>
        <rect x="74" y="24" width="30" height="252" style="fill: var(--ink, #e9e4d8)" />
        <rect class="bare-bar" style="--d:0ms; fill: var(--gold-fill, #c9a96e)" x="104" y="24" width="300" height="62" />
        <rect class="bare-bar" style="--d:120ms; fill: var(--blue-fill, #4a6cf7)" x="104" y="117" width="190" height="62" />
        <rect class="bare-bar" style="--d:240ms; fill: var(--pink-fill, #f8bfd6)" x="104" y="210" width="260" height="62" />
      </svg>
      <figcaption>
        <span>
          <em>fig. i</em> — E, as a bar chart
        </span>
        <span>n = 1</span>
      </figcaption>
    </figure>
  )
}

<style>
  .bare-fig {
    margin: 0;
    padding: 28px 28px 18px;
    border: 1px solid var(--line, rgba(201, 169, 110, 0.28));
    background: color-mix(in srgb, var(--ink, #e9e4d8) 3%, transparent);
  }
  .bare-fig svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .bare-grid line {
    stroke: color-mix(in srgb, var(--gold-fill, #c9a96e) 18%, transparent);
  }
  .bare-label text {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    fill: var(--dim, #8f8a7d);
  }
  .bare-bar {
    transform-box: fill-box;
    transform-origin: left center;
    animation: bare-grow 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--d) + 200ms);
  }
  @keyframes bare-grow {
    from {
      transform: scaleX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bare-bar {
      animation: none;
    }
  }
  figcaption {
    display: flex;
    justify-content: space-between;
    margin-top: 12px;
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    color: var(--dim, #8f8a7d);
  }
  figcaption em {
    font-family: 'Instrument Serif', serif;
    font-size: 14px;
    color: var(--gold, #c9a96e);
  }
</style>
