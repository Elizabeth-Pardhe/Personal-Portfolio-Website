---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import { profile, about, links, projects, experience, education, skills } from '~/data/profile';

const metadata = {
  title: `${profile.name} — ${profile.headline}`,
  ignoreTitleTemplate: true,
  description: profile.intro,
};

const initials = profile.name
  .split(' ')
  .map((w) => w[0])
  .join('')
  .slice(0, 2);

const socials = [
  links.github && { label: 'GitHub', icon: 'tabler:brand-github', href: links.github },
  links.linkedin && { label: 'LinkedIn', icon: 'tabler:brand-linkedin', href: links.linkedin },
  links.email && { label: 'Email', icon: 'tabler:mail', href: `mailto:${links.email}` },
].filter(Boolean) as { label: string; icon: string; href: string }[];

const timeline = [
  ...(experience.length ? [{ heading: 'Experience', icon: 'tabler:briefcase', items: experience }] : []),
  ...(education.length ? [{ heading: 'Education', icon: 'tabler:school', items: education }] : []),
];

const sectionTitle = 'text-3xl md:text-4xl font-bold tracking-tight font-heading mb-10';
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <section id="home" class="relative overflow-hidden">
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-b from-blue-50 to-transparent dark:from-slate-900/60"
      aria-hidden="true"
    >
    </div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-16 pb-20 md:pt-28 md:pb-28 text-center">
      <div
        class="mx-auto mb-8 h-28 w-28 rounded-full bg-gradient-to-br from-primary to-accent text-white flex items-center justify-center text-4xl font-bold shadow-lg"
        aria-hidden="true"
      >
        {initials}
      </div>
      <h1 class="text-5xl md:text-6xl font-bold leading-tighter tracking-tighter font-heading dark:text-gray-200">
        {profile.name}
      </h1>
      <p class="mt-4 text-xl md:text-2xl font-medium text-primary dark:text-blue-300">{profile.headline}</p>
      {
        profile.location && (
          <p class="mt-2 text-muted dark:text-slate-400 inline-flex items-center gap-1">
            <Icon name="tabler:map-pin" class="w-4 h-4" /> {profile.location}
          </p>
        )
      }
      <p class="mt-6 max-w-2xl mx-auto text-lg md:text-xl text-muted dark:text-slate-400">{profile.intro}</p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a class="btn-primary" href="#projects">See my work</a>
        <a class="btn" href="#contact">Get in touch</a>
        {
          profile.resumeUrl && (
            <a class="btn" href={profile.resumeUrl} target="_blank" rel="noopener">
              <Icon name="tabler:file-cv" class="w-5 h-5 mr-2" /> Résumé
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="scroll-mt-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 md:py-20">
      <h2 class={sectionTitle}>About me</h2>
      <div class="space-y-5 text-lg text-muted dark:text-slate-300 leading-relaxed">
        {about.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects" class="scroll-mt-16 bg-blue-50/60 dark:bg-slate-900/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-16 md:py-20">
      <h2 class={sectionTitle}>Projects</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {
          projects.map((p) => (
            <article class="flex flex-col rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 shadow-sm hover:shadow-md transition">
              <h3 class="text-xl font-semibold mb-2 dark:text-white">{p.title}</h3>
              <p class="text-muted dark:text-slate-400 flex-1">{p.description}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {p.tech.map((t) => (
                  <li class="text-xs font-medium rounded-full bg-blue-100 text-blue-800 dark:bg-slate-800 dark:text-blue-300 px-2.5 py-1">
                    {t}
                  </li>
                ))}
              </ul>
              {p.href && (
                <a
                  href={p.href}
                  target="_blank"
                  rel="noopener"
                  class="mt-5 inline-flex items-center font-medium text-primary dark:text-blue-300 hover:underline"
                >
                  View project <Icon name="tabler:arrow-up-right" class="w-4 h-4 ml-1" />
                </a>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Experience / Education -->
  {
    timeline.length > 0 && (
      <section id="experience" class="scroll-mt-16">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 md:py-20 grid gap-12 md:grid-cols-2">
          {timeline.map((group) => (
            <div>
              <h2 class="text-3xl font-bold tracking-tight font-heading mb-8">{group.heading}</h2>
              <ol class="relative border-l-2 border-blue-200 dark:border-slate-700 ml-3 space-y-8">
                {group.items.map((item) => (
                  <li class="pl-8 relative">
                    <span class="absolute -left-[17px] top-0 flex h-8 w-8 items-center justify-center rounded-full bg-white dark:bg-slate-900 border-2 border-primary">
                      <Icon name={group.icon} class="w-4 h-4 text-primary" />
                    </span>
                    <h3 class="text-lg font-semibold dark:text-white">{item.title}</h3>
                    <p class="text-muted dark:text-slate-400">{item.org}</p>
                    {item.dates && <p class="text-sm text-muted dark:text-slate-500">{item.dates}</p>}
                    {item.description && <p class="mt-2 text-muted dark:text-slate-300">{item.description}</p>}
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Skills -->
  <section id="skills" class="scroll-mt-16 bg-blue-50/60 dark:bg-slate-900/40">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 md:py-20">
      <h2 class={sectionTitle}>Skills</h2>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          Object.entries(skills).map(([group, list]) => (
            <div>
              <h3 class="text-lg font-semibold mb-3 dark:text-white">{group}</h3>
              <ul class="flex flex-wrap gap-2">
                {list.map((s) => (
                  <li class="rounded-lg border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-3 py-1.5 text-sm">
                    {s}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="scroll-mt-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16 md:py-24 text-center">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight font-heading mb-4">Let's connect</h2>
      <p class="text-lg text-muted dark:text-slate-400 mb-10">
        I'm open to data science, analytics, product, and research opportunities — I'd love to hear from you.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        {
          socials.map((s, i) => (
            <a
              class={i === 0 ? 'btn-primary' : 'btn'}
              href={s.href}
              target={s.href.startsWith('mailto:') ? undefined : '_blank'}
              rel="noopener"
            >
              <Icon name={s.icon} class="w-5 h-5 mr-2" /> {s.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
