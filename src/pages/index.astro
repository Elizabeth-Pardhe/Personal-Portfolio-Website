---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/jetbrains-mono/400.css';

import Layout from '~/layouts/Layout.astro';
import BarE from '~/components/BarE.astro';
import {
  profile,
  about,
  links,
  projects,
  experience,
  education,
  leadership,
  skills,
  stats,
  values,
  personal,
  highlights,
} from '~/data/profile';

const metadata = {
  title: `${profile.name} | ${profile.headline}`,
  ignoreTitleTemplate: true,
  description: profile.intro,
};

const roman = (n: number) =>
  ['i', 'ii', 'iii', 'iv', 'v', 'vi', 'vii', 'viii', 'ix', 'x', 'xi', 'xii'][n] ?? String(n + 1);

const [first, ...rest] = profile.name.split(' ');
const last = rest.join(' ');

const nav = [
  { text: 'About', href: '#about' },
  { text: 'Work', href: '#work' },
  { text: 'Experience', href: '#experience' },
  { text: 'Leadership', href: '#leadership' },
  { text: 'Contact', href: '#contact' },
];

const contacts = [
  links.email && { label: links.email, href: `mailto:${links.email}` },
  links.linkedin && { label: 'LinkedIn', href: links.linkedin },
  links.github && { label: 'GitHub', href: links.github },
  links.instagram && { label: 'Photography', href: links.instagram },
].filter(Boolean) as { label: string; href: string }[];
---

<Layout metadata={metadata}>
  <div class="site">
    <!-- Header -->
    <header class="hdr">
      <div class="wrap hdr-in">
        <a href="#top" class="brand" aria-label={`${profile.name}, home`}>
          <BarE size={30} />
          <span>{profile.name}</span>
        </a>
        <button type="button" class="theme-btn" data-aw-toggle-color-scheme aria-label="Toggle light and dark mode">
          <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
            ><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path
              d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"></path></svg
          >
          <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
            ><path
              d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"></path></svg
          >
        </button>
        <input type="checkbox" id="menu" class="menu-toggle" aria-label="Toggle menu" />
        <label for="menu" class="menu-btn" aria-hidden="true"><span></span><span></span></label>
        <nav class="nav" aria-label="Primary">
          {nav.map((l) => <a href={l.href}>{l.text}</a>)}
        </nav>
      </div>
    </header>

    <main id="top">
      <!-- Hero -->
      <section class="hero wrap">
        <div class="hero-text">
          {
            profile.status && (
              <p class="status">
                <i aria-hidden="true"></i>
                {profile.status}
              </p>
            )
          }
          <p class="kicker">Data Science &amp; Economics · ASU Barrett</p>
          <h1>
            {first} <em>{last}</em>
          </h1>
          <p class="lede">{profile.intro}</p>
          {
            profile.now?.length > 0 && (
              <p class="now">
                <span>Currently</span>
                {profile.now.join(' · ')}
              </p>
            )
          }
          <div class="cta">
            <a class="btn-gold" href="#work">Selected work</a>
            <a class="btn-line" href="#contact">Get in touch</a>
          </div>
          {profile.location && <p class="loc">{profile.location}</p>}
        </div>
        <div class="hero-fig">
          <BarE variant="figure" />
        </div>
      </section>

      {
        stats.length > 0 && (
          <section class="wrap" aria-label="Highlights">
            <div class="stats">
              {stats.map((s) => (
                <div>
                  <b>{s.value}</b>
                  <span>{s.label}</span>
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        values.length > 0 && (
          <section class="wrap values" aria-label="What I care about">
            <p class="kicker">What I care about</p>
            <div class="values-grid">
              {values.map((v, i) => (
                <div>
                  <span class="vbar" data-i={i % 3} aria-hidden="true" />
                  <h3>{v.title}</h3>
                  <p>{v.text}</p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <!-- About -->
      <section id="about" class="wrap sec">
        <div class="sec-head">
          <span class="num">i.</span>
          <h2>About me</h2>
        </div>
        <div class="about">
          {
            profile.photoUrl && (
              <img src={profile.photoUrl} alt={profile.name} width="200" height="200" loading="lazy" class="portrait" />
            )
          }
          <div class="about-copy">
            {
              highlights.length > 0 && (
                <div class="short">
                  <h3>The short version</h3>
                  <dl>
                    {highlights.map((h, i) => (
                      <div>
                        <dt data-i={i % 3}>{h.label}</dt>
                        <dd>{h.text}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
              )
            }
            {about.map((p) => <p>{p}</p>)}
            {
              personal?.text && (
                <p class="personal">
                  {personal.text}{' '}
                  {personal.linkUrl && (
                    <a href={personal.linkUrl} target="_blank" rel="noopener">
                      {personal.linkLabel}
                    </a>
                  )}
                </p>
              )
            }
          </div>
        </div>
      </section>

      <!-- Work -->
      <section id="work" class="wrap sec">
        <div class="sec-head">
          <span class="num">ii.</span>
          <h2>Selected work</h2>
        </div>
        <ol class="work">
          {
            projects.map((p, i) => (
              <li class="work-row">
                <span class="work-n">{roman(i)}.</span>
                <div class="work-body">
                  <h3>
                    {p.href ? (
                      <a href={p.href} target="_blank" rel="noopener">
                        {p.title} ↗
                      </a>
                    ) : (
                      p.title
                    )}
                  </h3>
                  {p.subtitle && <p class="gold-sub">{p.subtitle}</p>}
                  <p class="blurb">{p.blurb}</p>
                  <ul class="points">
                    {p.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                </div>
                <div class="work-meta">
                  {p.date && <span class="date">{p.date}</span>}
                  <ul class="tags">
                    {p.tech.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                  {p.note && <p class="note">{p.note}</p>}
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Experience + Education -->
      <section id="experience" class="wrap sec">
        <div class="sec-head">
          <span class="num">iii.</span>
          <h2>Experience</h2>
        </div>
        <ol class="tl">
          {
            experience.map((e) => (
              <li>
                <span class="date">{e.dates}</span>
                <div>
                  <h3>{e.title}</h3>
                  <p class="gold-sub">{e.org}</p>
                  {e.description && <p class="desc">{e.description}</p>}
                </div>
              </li>
            ))
          }
        </ol>

        {
          education.length > 0 && (
            <>
              <h3 class="sub-head">Education</h3>
              <ol class="tl">
                {education.map((e) => (
                  <li>
                    <span class="date">{e.dates}</span>
                    <div>
                      <h3>{e.title}</h3>
                      <p class="gold-sub">{e.org}</p>
                      {e.description && <p class="desc">{e.description}</p>}
                    </div>
                  </li>
                ))}
              </ol>
            </>
          )
        }
      </section>

      <!-- Leadership -->
      {
        leadership.length > 0 && (
          <section id="leadership" class="wrap sec">
            <div class="sec-head">
              <span class="num">iv.</span>
              <h2>Leadership</h2>
            </div>
            <div class="lead">
              {leadership.map((o) => (
                <article>
                  <header>
                    <h3>{o.org}</h3>
                    <span class="date">{o.dates}</span>
                  </header>
                  {o.summary && <p class="summary">{o.summary}</p>}
                  <ol class="roles">
                    {o.roles.map((r) => (
                      <li>
                        <span class="role">{r.title}</span> <span class="date">{r.dates}</span>
                      </li>
                    ))}
                  </ol>
                  {o.roles.some((r) => r.points?.length) && (
                    <details>
                      <summary>What I did</summary>
                      <ul class="points">
                        {o.roles.flatMap((r) => r.points ?? []).map((pt) => (
                          <li>{pt}</li>
                        ))}
                      </ul>
                    </details>
                  )}
                </article>
              ))}
            </div>
          </section>
        )
      }

      <!-- Skills -->
      <section id="skills" class="wrap sec">
        <div class="sec-head">
          <span class="num">v.</span>
          <h2>Toolkit</h2>
        </div>
        <div class="skills">
          {
            Object.entries(skills).map(([group, list]) => (
              <div>
                <h3>{group}</h3>
                <p>{list.join(' · ')}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Contact -->
      <section id="contact" class="wrap contact">
        <p class="kicker">vi. Contact</p>
        <h2>Let's <em>talk.</em></h2>
        <p class="lede">
          I'm always happy to talk about data, economics, research or product, or about a project you're working on.
        </p>
        <div class="contact-links">
          {
            contacts.map((c) => (
              <a href={c.href} target={c.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener">
                {c.label}
              </a>
            ))
          }
        </div>
      </section>
    </main>

    <footer class="wrap ftr">
      <span class="brand small"><BarE size={18} /> {profile.name}</span>
      <span>© {new Date().getFullYear()} · Built with Astro</span>
    </footer>
  </div>
</Layout>

<style>
  /* Light theme (default tokens) */
  .site {
    --bg: #f6f1e7;
    --ink: #16181a;
    --muted: #4d4a43;
    --dim: #6f6858;
    --gold: #8a6a2c;
    --gold-fill: #c9a96e;
    --gold-hover: #b08a45;
    --blue: #2a4fd0;
    --blue-fill: #4169e1;
    --pink: #b4446f;
    --pink-fill: #f4c2d7;
    --line: rgba(138, 106, 44, 0.28);
    --on-gold: #16181a;
    --serif: 'Instrument Serif', Georgia, serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    background: var(--bg);
    color: var(--ink);
    font-family: 'InterVariable', Inter, system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.7;
    letter-spacing: 0;
    min-height: 100vh;
    overflow-x: clip;
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  /* Dark theme: forest black & gold */
  :global(.dark) .site {
    --bg: #0f1d1a;
    --ink: #e9e4d8;
    --muted: #b3ac9c;
    --dim: #8f8a7d;
    --gold: #c9a96e;
    --gold-fill: #c9a96e;
    --gold-hover: #dec492;
    --blue: #8ea4f5;
    --blue-fill: #4169e1;
    --pink: #f4c2d7;
    --pink-fill: #f4c2d7;
    --line: rgba(201, 169, 110, 0.24);
    --on-gold: #0f1d1a;
  }
  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  @media (min-width: 768px) {
    .wrap {
      padding-left: 48px;
      padding-right: 48px;
    }
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  h1,
  h2,
  h3 {
    font-family: var(--serif);
    font-weight: 400;
    letter-spacing: -0.005em;
  }
  em {
    color: var(--gold);
  }

  /* Header */
  .hdr {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .hdr-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--serif);
    font-size: 22px;
  }
  .nav {
    display: flex;
    gap: 30px;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .nav a:hover {
    color: var(--pink);
  }
  .hdr-in {
    gap: 20px;
  }
  .nav {
    margin-left: auto;
  }
  .theme-btn {
    order: 3;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--gold);
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s;
  }
  .theme-btn:hover {
    color: var(--pink);
    border-color: var(--pink);
  }
  .i-moon {
    display: none;
  }
  :global(.dark) .i-moon {
    display: block;
  }
  :global(.dark) .i-sun {
    display: none;
  }
  .menu-toggle,
  .menu-btn {
    display: none;
  }
  @media (max-width: 767px) {
    .theme-btn {
      margin-left: auto;
    }
    .menu-btn {
      order: 4;
      display: grid;
      gap: 6px;
      cursor: pointer;
      padding: 10px 4px;
    }
    .menu-btn span {
      display: block;
      width: 24px;
      height: 1.5px;
      background: var(--ink);
    }
    .nav {
      display: none;
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      padding: 8px 24px 16px;
    }
    .nav a {
      padding: 12px 0;
    }
    .menu-toggle:checked ~ .nav {
      display: flex;
    }
  }

  /* Hero */
  .hero {
    display: grid;
    gap: 56px;
    align-items: center;
    padding-top: 96px;
    padding-bottom: 72px;
  }
  @media (min-width: 960px) {
    .hero {
      grid-template-columns: 1.2fr 1fr;
      padding-top: 120px;
      padding-bottom: 96px;
    }
  }
  .kicker {
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .hero h1 {
    font-size: clamp(56px, 9vw, 104px);
    line-height: 1;
    margin: 22px 0 26px;
  }
  .lede {
    font-size: 19px;
    color: var(--muted);
    max-width: 34em;
  }
  .cta {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    align-items: center;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .btn-gold {
    padding: 14px 26px;
    background: var(--gold-fill);
    color: var(--on-gold);
    transition: background 0.2s;
  }
  .btn-gold:hover {
    background: var(--gold-hover);
  }
  .btn-line {
    border-bottom: 1px solid var(--gold);
    padding-bottom: 3px;
  }
  .btn-line:hover {
    color: var(--pink);
    border-color: var(--pink);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 26px;
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 13px;
    color: var(--ink);
  }
  .status i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--pink-fill);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--pink-fill) 25%, transparent);
  }
  .now {
    margin-top: 22px;
    font-size: 15px;
    color: var(--muted);
    max-width: 36em;
  }
  .now span {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 2px;
  }
  .values {
    padding-top: 96px;
  }
  .values-grid {
    display: grid;
    gap: 36px;
    margin-top: 28px;
  }
  @media (min-width: 768px) {
    .values-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 48px;
    }
  }
  .vbar {
    display: block;
    height: 4px;
    width: 64px;
    margin-bottom: 18px;
    background: var(--gold-fill);
  }
  .vbar[data-i='1'] {
    background: var(--blue-fill);
    width: 44px;
  }
  .vbar[data-i='2'] {
    background: var(--pink-fill);
    width: 54px;
  }
  .values h3 {
    font-size: 28px;
    line-height: 1.15;
    margin-bottom: 10px;
  }
  .values p:not(.kicker) {
    color: var(--muted);
    font-size: 15px;
  }
  .personal {
    margin-top: 28px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .personal a {
    color: var(--pink);
    border-bottom: 1px solid currentColor;
  }
  .note {
    margin-top: 12px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--dim);
  }
  .roles {
    margin-top: 14px;
  }
  .roles li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 12px;
    padding: 6px 0;
    border-bottom: 1px dashed var(--line);
  }
  details {
    margin-top: 14px;
  }
  details summary {
    cursor: pointer;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
    list-style: none;
  }
  details summary::-webkit-details-marker {
    display: none;
  }
  details summary::after {
    content: ' +';
  }
  details[open] summary::after {
    content: ' −';
  }
  .loc {
    margin-top: 28px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--dim);
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stats > div {
    padding: 26px 16px 26px 0;
  }
  .stats > div::before {
    content: '';
    display: block;
    width: 28px;
    height: 3px;
    margin-bottom: 14px;
    background: var(--gold-fill);
  }
  .stats > div:nth-child(3n + 2)::before {
    background: var(--blue-fill);
  }
  .stats > div:nth-child(3n + 3)::before {
    background: var(--pink-fill);
  }
  .stats b {
    display: block;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 44px;
    line-height: 1.1;
    color: var(--gold);
  }
  .stats span {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--dim);
  }

  /* Sections */
  .sec {
    padding-top: 112px;
    scroll-margin-top: 40px;
  }
  .sec-head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 8px;
  }
  .num {
    font-family: var(--serif);
    font-style: italic;
    font-size: 22px;
    color: var(--gold);
  }
  .sec-head h2 {
    font-size: clamp(40px, 5vw, 56px);
    line-height: 1;
  }
  .gold-sub {
    color: var(--gold);
    font-size: 14px;
    margin-top: 4px;
  }
  .date {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--dim);
    white-space: nowrap;
  }
  .points {
    margin-top: 12px;
    padding-left: 18px;
    color: var(--muted);
    font-size: 15px;
  }
  .points li {
    list-style: none;
    position: relative;
    margin-bottom: 6px;
  }
  .points li::before {
    content: '';
    position: absolute;
    left: -16px;
    top: 0.8em;
    width: 7px;
    height: 1px;
    background: var(--gold);
  }

  /* About */
  .about {
    display: grid;
    gap: 40px;
    padding-top: 32px;
  }
  @media (min-width: 768px) {
    .about {
      grid-template-columns: 200px 1fr;
      gap: 56px;
    }
  }
  .portrait {
    width: 160px;
    height: 160px;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid var(--gold);
    padding: 5px;
    filter: saturate(0.85);
  }
  @media (min-width: 768px) {
    .portrait {
      width: 200px;
      height: 200px;
    }
  }
  .about-copy p {
    font-size: 17px;
    color: var(--muted);
    margin-bottom: 18px;
    max-width: 40em;
  }
  .short {
    margin-bottom: 36px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
  }
  .short h3 {
    font-size: 30px;
    line-height: 1.1;
    margin-bottom: 18px;
  }
  .short dl > div {
    display: grid;
    gap: 2px 24px;
    padding: 12px 0;
